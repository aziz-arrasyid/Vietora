  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Quizz
  quest:
  - question: "1.Perahu digunakan oleh pengungsi untuk\u2026"
    correctAnswer: 1
    options:
    - A. Berdagang antar pulau
    - B. Melarikan diri dari Vietnam
    - C. Berwisata
    - D. Menangkap ikan
  - question: "2.Pengungsi Vietnam melarikan diri karena\u2026"
    correctAnswer: 2
    options:
    - A. Mencari hiburan
    - B. Berdagang
    - C. Perang dan konflik
    - D. Mengikuti lomba
  - question: "3.Perjalanan dengan perahu saat itu\u2026"
    correctAnswer: 3
    options:
    - A. Aman dan nyaman
    - B. Sangat cepat
    - C. Gratis dan terjamin
    - D. Berbahaya dan tidak pasti
  - question: "4.Istilah internasional untuk pengungsi yang melarikan diri lewat
      laut adalah\u2026"
    correctAnswer: 1
    options:
    - A. Sea traveler
    - B. Boat people
    - C. Ocean worker
    - D. Refugee camp
  - question: "5.Banyak perahu pengungsi berangkat dari\u2026"
    correctAnswer: 0
    options:
    - A. Filipina
    - B. Jepang
    - C. Vietnam
    - D. Korea
